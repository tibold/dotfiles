#!/bin/bash
# Toggle GNOME desktop features that have no convenient switch in Settings,
# optionally per session kind.
#
# Usage:
#   gdm <feature> <on|off|true|false|1|0>   set it
#   gdm <feature>                           show its current state
#   gdm list                                show every feature and its state
#   gdm session                             report this session's kind
#   gdm apply                               apply the policy for this session
#
# WHY "apply" EXISTS
#
# gsettings live in dconf, which is per USER and not per session, so nothing
# here can be scoped to the headless RDP session by configuration alone. The
# only place a per-session difference can be made is at session start: "gdm
# apply" reads the session's kind from logind and sets each feature to whatever
# POLICY says it should be there. An autostart entry runs it on login.
#
# Consequence worth knowing: if a remote and a local session are logged in at
# the same time, the one that started last has set the values, because there is
# only one dconf database behind both.
#
# To add a feature, write three functions named after it -- <feature>_on,
# <feature>_off and <feature>_status -- add its name to FEATURES, and give it
# POLICY entries if it should differ by session kind. Nothing else changes.

set -euo pipefail

FEATURES=(
  screenlock
)

# What each feature should be, per session kind, when "gdm apply" runs.
# Key is "<feature>:<kind>", where kind is remote, local or unknown. A feature
# with no entry for a kind is left alone.
declare -A POLICY=(
  [screenlock:remote]=off
  [screenlock:local]=on
)

# --- screenlock ---------------------------------------------------------------
# Off means the desktop never blanks and never locks itself. Super+L still locks
# on demand: that would need org.gnome.desktop.lockdown disable-lock-screen,
# which removes the ability altogether and is deliberately not touched here.

screenlock_off() {
  gsettings set org.gnome.desktop.session idle-delay 0
  gsettings set org.gnome.desktop.screensaver lock-enabled false
  gsettings set org.gnome.desktop.screensaver idle-activation-enabled false
}

screenlock_on() {
  # reset rather than hardcoding the defaults, so this follows GNOME's own
  # values instead of freezing whatever they happened to be when this was
  # written.
  gsettings reset org.gnome.desktop.session idle-delay
  gsettings reset org.gnome.desktop.screensaver lock-enabled
  gsettings reset org.gnome.desktop.screensaver idle-activation-enabled
}

screenlock_status() {
  local locking idle
  locking=$(gsettings get org.gnome.desktop.screensaver lock-enabled)
  # "uint32 300" -> "300". Not tr -d, which deletes the digits it shares with the
  # type name too and turned 300 into 00.
  idle=$(gsettings get org.gnome.desktop.session idle-delay | awk '{print $NF}')

  if [ "$locking" = "false" ]; then
    printf 'off'
  else
    printf 'on (locks after %ss idle)' "$idle"
  fi
}

# --- session detection --------------------------------------------------------

# remote, local, or unknown.
#
# logind's Remote property is the discriminator, and it is the honest one: a
# gnome-remote-desktop session reports Remote=yes with a RemoteHost, while a
# session on the physical seat reports no. XDG_SESSION_TYPE cannot be used --
# both are "wayland".
#
# XDG_SESSION_ID is preferred when set, but it is absent in a shell started a
# few processes deep, so fall back to this user's graphical session: Class=user
# excludes the systemd manager sessions and the gdm greeter.
session_kind() {
  local id="${XDG_SESSION_ID:-}" candidate

  if [ -z "$id" ]; then
    for candidate in $(loginctl list-sessions --no-legend 2>/dev/null |
                       awk -v user="$(id -un)" '$3 == user { print $1 }'); do
      if [ "$(loginctl show-session "$candidate" -p Class --value 2>/dev/null)" = "user" ]; then
        id="$candidate"
        break
      fi
    done
  fi

  [ -n "$id" ] || { printf 'unknown'; return 0; }

  case "$(loginctl show-session "$id" -p Remote --value 2>/dev/null)" in
    yes) printf 'remote' ;;
    no)  printf 'local' ;;
    *)   printf 'unknown' ;;
  esac
}

# Every remote graphical session this user has, one id per line. Used by "apply"
# to decide who wins when both kinds are present.
remote_sessions() {
  local candidate
  for candidate in $(loginctl list-sessions --no-legend 2>/dev/null |
                     awk -v user="$(id -un)" '$3 == user { print $1 }'); do
    [ "$(loginctl show-session "$candidate" -p Class --value 2>/dev/null)" = "user" ] || continue
    [ "$(loginctl show-session "$candidate" -p Remote --value 2>/dev/null)" = "yes" ] || continue
    printf '%s\n' "$candidate"
  done
}

# --- plumbing -----------------------------------------------------------------

die() { printf 'gdm: %s\n' "$*" >&2; exit 1; }

is_feature() {
  local candidate
  for candidate in "${FEATURES[@]}"; do
    [ "$candidate" = "$1" ] && return 0
  done
  return 1
}

usage() {
  printf 'usage: gdm <feature> <on|off>\n'
  printf '       gdm <feature>\n'
  printf '       gdm list | session | apply\n\n'
  printf 'features: %s\n' "${FEATURES[*]}"
}

case "${1:-list}" in
  list|-l|--list)
    for feature in "${FEATURES[@]}"; do
      printf '%-16s %s\n' "$feature" "$("${feature}_status")"
    done
    exit 0
    ;;
  session)
    printf '%s\n' "$(session_kind)"
    exit 0
    ;;
  apply)
    kind=$(session_kind)
    # Never guess. An unrecognised session gets the values it already had rather
    # than one kind's policy applied to the other by accident.
    [ "$kind" != "unknown" ] || die "could not determine the session kind -- nothing applied"

    # Remote wins when both kinds are logged in at once.
    #
    # A local login and a headless remote session can coexist -- the remote one
    # has no seat, so GDM has nothing to switch to and makes a second session --
    # and there is still only one dconf database behind both. Without this,
    # logging in locally would run its own "apply", set the local policy, and
    # silently reinstate screen locking in the remote session somebody is
    # working in.
    #
    # Remote is the one that gets deferred to because it is the one being used;
    # a local login is normally somebody standing at the machine briefly.
    if [ "$kind" = "local" ] && [ -n "$(remote_sessions)" ]; then
      printf 'gdm: a remote session is also logged in -- leaving its settings alone\n' >&2
      exit 0
    fi
    for feature in "${FEATURES[@]}"; do
      wanted="${POLICY[$feature:$kind]:-}"
      [ -n "$wanted" ] || continue
      "${feature}_${wanted}"
      printf '%-16s %-4s (%s session)\n' "$feature" "$wanted" "$kind"
    done
    exit 0
    ;;
  help|-h|--help)
    usage
    exit 0
    ;;
esac

feature="$1"
is_feature "$feature" || die "unknown feature: $feature (try: gdm list)"

# No state given: report rather than change. A toggle script that changes
# something when asked a question is a trap.
if [ $# -lt 2 ]; then
  printf '%-16s %s\n' "$feature" "$("${feature}_status")"
  exit 0
fi

case "$2" in
  on|true|1|yes|enable)   "${feature}_on" ;;
  off|false|0|no|disable) "${feature}_off" ;;
  *) die "expected on|off|true|false|1|0, got: $2" ;;
esac

printf '%-16s %s\n' "$feature" "$("${feature}_status")"
